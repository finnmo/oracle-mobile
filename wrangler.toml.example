name = "your-picker"
main = "worker/index.ts"
compatibility_date = "2025-01-01"

[assets]
directory = "./dist"
binding = "ASSETS"
run_worker_first = true

[[d1_databases]]
binding = "DB"
database_name = "oracle-db"
database_id = "REPLACE_WITH_wrangler_d1_create_output"

[[unsafe.bindings]]
name = "RATE_LIMITER"
type = "ratelimit"
namespace_id = "1001"
simple = { limit = 30, period = 60 }

[vars]
SITE_ORIGIN = "https://picker.example.com"
# Weekly schedule (local wall times). Onboard wizard fills these + UTC crons below.
SCHEDULE_TIMEZONE = "Australia/Perth"
SCHEDULE_ANNOUNCE_WEEKDAY = "5"
SCHEDULE_ANNOUNCE_TIME = "10:00"
SCHEDULE_MEET_TIME = "12:00"
SCHEDULE_RATE_OPEN_TIME = "12:20"
SCHEDULE_RATE_CLOSE_TIME = "23:59"
# "wa" = shift one day earlier when announce weekday is a WA public holiday; "none" = off
SCHEDULE_HOLIDAY_SHIFT = "none"
# Exact triggers (filled by onboard). Worker matches Cloudflare event.cron to these first.
SCHEDULE_CRON_ANNOUNCE = "0 2 * * FRI"
SCHEDULE_CRON_OPEN = "20 4 * * FRI"
SCHEDULE_CRON_CLOSE = "59 15 * * SAT"

[triggers]
# Generated for the schedule above (UTC). Re-run npm run onboard or edit + convert if you change local times.
crons = [
  "0 2 * * FRI",
  "20 4 * * FRI",
  "59 15 * * SAT",
]
