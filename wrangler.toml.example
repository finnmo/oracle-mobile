name = "your-picker"
main = "worker/index.ts"
compatibility_date = "2025-01-01"

[assets]
directory = "./dist"
binding = "ASSETS"
run_worker_first = true

[[d1_databases]]
binding = "DB"
database_name = "oracle-db"
database_id = "REPLACE_WITH_wrangler_d1_create_output"

[[unsafe.bindings]]
name = "RATE_LIMITER"
type = "ratelimit"
namespace_id = "1001"
simple = { limit = 30, period = 60 }

[vars]
SITE_ORIGIN = "https://picker.example.com"

[triggers]
crons = [
  "0 2 * * THU,FRI",
  "20 4 * * THU,FRI",
  "59 15 * * FRI,SAT",
]
